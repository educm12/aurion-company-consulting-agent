# Third party keys
OPENAI_API_KEY = '****'
ANTHROPIC_API_KEY = '****'
GOOGLE_API_KEY = '****'
TAVILY_API_KEY = '****'
GROQ_API_KEY = '****'

# Langsmith keys
LANGSMITH_API_KEY = '****'
LANGSMITH_TRACING=true
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_PROJECT=company-chatbot-project

# LangGraph API keys (if using LangGraph Cloud/API)
LANGGRAPH_API_KEY = '****'

# Evaluator example (use the model you want, but not the same that generates
# the answers, since there could be a bias of auto-evaluation)
EVAL_JUDGE_PROVIDER=groq
EVAL_JUDGE_MODEL=qwen/qwen3.8-27b

# Redis
REDIS_URL=redis://localhost:6379
CACHE_SIMILARITY_THRESHOLD=0.80
CACHE_INDEX_NAME=aurion_semantic_cache
CACHE_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
CACHE_ENABLED=true
CACHE_TTL_POLICY_SECONDS=86400   # se resetea cada 24h, política pura (igual para todos)
CACHE_TTL_PERSONAL_SECONDS=1800  # se resetea cada 30min, datos personales